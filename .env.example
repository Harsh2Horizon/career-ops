# No remote AI service is required. Secrets are never stored in public config.
# Use a writable cache when running under the Codex filesystem sandbox.
UV_CACHE_DIR=.cache/uv
# Optional path to Chromium when the installed Playwright browser revision differs.
# CAREEROPS_CHROMIUM_EXECUTABLE=/absolute/path/to/chromium
# Optional canonical profile outside this repository.
# CAREEROPS_PROFILE=/absolute/path/to/resume.yaml
